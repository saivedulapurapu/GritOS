# Copy to .env (repo root or backend/). Never commit .env.

# Optional: enables the AI advisor and dashboard bullets. Everything else works without it.
GROQ_API_KEY=

# Origins allowed to call the API (comma-separated). "*" is ignored.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Required only to download SEC EDGAR data (SEC fair-access policy: name + contact email).
SEC_USER_AGENT="GritOS research you@example.com"

# Optional: database location (default backend/gritos.db).
# GRITOS_DB_URL=sqlite:///backend/gritos.db

# Frontend: Next.js reads this from frontend/.env.local (or the shell) at build/dev time.
NEXT_PUBLIC_API_URL=http://localhost:8000
